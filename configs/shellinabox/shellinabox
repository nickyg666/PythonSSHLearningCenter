# Should shellinaboxd start automatically
SHELLINABOX_DAEMON_START=1

# TCP port that shellinboxds listens on
SHELLINABOX_PORT=4200

# Options to pass to shellinaboxd daemon
# Auto-login as lorenzo user with no password required
SHELLINABOX_ARGS="--no-beep --disable-ssl --disable-ssl-menu --static-file=/vk.js:$(ls /var/lib/shellinabox/virtual-keyboard.js 2>/dev/null || echo /dev/null)"
